(
  schema_version: 7,
  server_name: "Local PewPew Blitz",
  formation_timing: (
    loading_deadline_seconds: 30,
    grant_deadline_seconds: 10,
  ),
  common_lifecycle: (
    spawn_protection_ticks: 90,
    completed_input_lock_ticks: 60,
  ),
  mode_policies: (
    takedown: (recent_hostile_damage_credit_ticks: 300),
    vault_break: (critical_health_percent: 25),
    shard_rush: (hold_seconds: 12, spawn_interval_seconds: 6, live_shard_ceiling: 12),
  ),
  map_dimension_limits: (
    minimum_width: 20,
    minimum_height: 20,
    maximum_width: 512,
    maximum_height: 512,
  ),
  map_publishing: (
    moderation: Approve,
    pending_per_account: 3,
    submit_cooldown_seconds: 120,
  ),
  game_types: [
    (id: "takedown-2v2", revision: 3, name: "Feature Yard Takedown 2v2", mode: "takedown", maps: ["feature-yard-takedown"], teams: 2, players_per_team: 2, kills_to_win: 10, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "turf-hold-2v2", revision: 3, name: "Feature Yard Turf Hold 2v2", mode: "turf-hold", maps: ["feature-yard-turf-hold"], teams: 2, players_per_team: 2, capture_seconds: 30, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "takedown-1v1", revision: 3, name: "Feature Yard Takedown 1v1", mode: "takedown", maps: ["feature-yard-takedown"], community_maps: true, teams: 2, players_per_team: 1, kills_to_win: 10, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "takedown-3v3", revision: 5, name: "Takedown 3v3", mode: "takedown", maps: ["verdant-crossfire", "sluicegate-works"], teams: 2, players_per_team: 3, kills_to_win: 10, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "turf-hold-1v1", revision: 3, name: "Feature Yard Turf Hold 1v1", mode: "turf-hold", maps: ["feature-yard-turf-hold"], teams: 2, players_per_team: 1, capture_seconds: 30, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "turf-hold-3v3", revision: 5, name: "Switchback Basin Turf Hold 3v3", mode: "turf-hold", maps: ["switchback-basin"], teams: 2, players_per_team: 3, capture_seconds: 30, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "vault-break-1v1", revision: 3, name: "Feature Yard Vault Break 1v1", mode: "vault-break", maps: ["feature-yard-vault-break"], teams: 2, players_per_team: 1, safe_health: 2000, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "vault-break-2v2", revision: 3, name: "Feature Yard Vault Break 2v2", mode: "vault-break", maps: ["feature-yard-vault-break"], teams: 2, players_per_team: 2, safe_health: 2000, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "vault-break-3v3", revision: 6, name: "Vault Break 3v3", mode: "vault-break", maps: ["powderline-vault"], teams: 2, players_per_team: 3, safe_health: 2000, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "shard-rush-3v3", revision: 1, name: "Shard Rush 3v3", mode: "shard-rush", maps: ["prism-quarry"], teams: 2, players_per_team: 3, shards_to_win: 8, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 3),
    (id: "zombie-2p", revision: 1, name: "Zombie Yard Co-op (2 players)", mode: "zombie", maps: ["zombie-yard"], teams: 1, players_per_team: 2, pressure_stages: 4, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 15),
    (id: "zombie-3p", revision: 1, name: "Zombie Yard Co-op (3 players)", mode: "zombie", maps: ["zombie-yard"], teams: 1, players_per_team: 3, pressure_stages: 4, match_duration_seconds: 180, countdown_seconds: 3, respawn_seconds: 15),
  ],
)
