        (id: "dash", asset: Some(Defeat), playback: OneShot, speed: 1.45, volume: 1.0, lifetime: UntilComplete, concurrency_cap: 24, fallback_profile: "silent"),
        (id: "sentry", asset: Some(Ready), playback: OneShot, speed: 1.0, volume: 1.0, lifetime: UntilComplete, concurrency_cap: 24, fallback_profile: "silent"),
