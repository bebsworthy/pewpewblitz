        (id: "charge_ready", asset: Some(Ready), playback: OneShot, speed: 1.25, volume: 1.0, lifetime: UntilComplete, concurrency_cap: 24, fallback_profile: "silent"),
        (id: "passive", asset: Some(Impact), playback: OneShot, speed: 1.35, volume: 1.0, lifetime: UntilComplete, concurrency_cap: 24, fallback_profile: "silent"),
        (id: "objective_hit", asset: Some(Impact), playback: OneShot, speed: 1.0, volume: 1.0, lifetime: UntilComplete, concurrency_cap: 6, fallback_profile: "silent"),
