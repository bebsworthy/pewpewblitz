        (id: "heist_destroyed", renderer: GroundRing, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(850), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("heist_destroyed_reduced")),
        (id: "heist_destroyed_reduced", renderer: GroundRing, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(425), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: None),
    ],
