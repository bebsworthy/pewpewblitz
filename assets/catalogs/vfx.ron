        (id: "pickup_ring_reduced", renderer: GroundRing, material: "pickup_glow", scale_multiplier: 0.65, lifetime: Millis(120), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "pickup_sphere_reduced", renderer: Sphere, material: "pickup_glow", scale_multiplier: 0.6, lifetime: Millis(120), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "heist_damage", renderer: Sphere, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(240), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("heist_damage_reduced")),
