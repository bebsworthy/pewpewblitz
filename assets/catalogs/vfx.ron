(
    schema_version: 1,
    default_profile: "impact",
    mappings: [
        (family: CombatMuzzle, profile: "muzzle"),
        (family: CombatImpact, profile: "impact"),
        (family: CombatDamage, profile: "damage"),
        (family: CombatReset, profile: "reset"),
        (family: RevealScan, profile: "reveal_scan"),
        (family: ElementalField, profile: "elemental_field"),
        (family: DemolitionStrike, profile: "demolition"),
        (family: WorldObjectDamaged, profile: "world_damage"),
        (family: WorldObjectExploded, profile: "world_explosion"),
        (family: PickupSpawned, profile: "pickup_spawn"),
        (family: PickupCollected, profile: "pickup_collect"),
        (family: PickupExpired, profile: "pickup_expire"),
        (family: HeistDamaged, profile: "heist_damage"),
        (family: HeistCritical, profile: "heist_critical"),
        (family: HeistDestroyed, profile: "heist_destroyed"),
    ],
    profiles: [
        (id: "muzzle", renderer: Sphere, material: "effect_muzzle", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: Some("muzzle_reduced")),
        (id: "muzzle_reduced", renderer: Sphere, material: "effect_muzzle", scale_multiplier: 0.65, lifetime: Millis(100), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "impact", renderer: Sphere, material: "effect_impact", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("impact_reduced")),
        (id: "impact_reduced", renderer: Sphere, material: "effect_impact", scale_multiplier: 0.65, lifetime: Millis(100), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: None),
        (id: "damage", renderer: Sphere, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: Some("damage_reduced")),
        (id: "damage_reduced", renderer: Sphere, material: "effect_damage", scale_multiplier: 0.65, lifetime: Millis(100), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "reset", renderer: Sphere, material: "effect_muzzle", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "muzzle", reduced_profile: Some("muzzle_reduced")),
        (id: "reveal_scan", renderer: GroundRing, material: "scan_area", scale_multiplier: 1.0, lifetime: AuthoritativeDeadline, concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "elemental_field", renderer: Sphere, material: "scan_area", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: Some("elemental_field_reduced")),
        (id: "elemental_field_reduced", renderer: Sphere, material: "scan_area", scale_multiplier: 0.65, lifetime: Millis(100), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: None),
        (id: "demolition", renderer: Sphere, material: "demolition_area", scale_multiplier: 1.0, lifetime: Millis(180), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("demolition_reduced")),
        (id: "demolition_reduced", renderer: Sphere, material: "demolition_area", scale_multiplier: 0.65, lifetime: Millis(100), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: None),
        (id: "world_damage", renderer: Sphere, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(280), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("world_damage_reduced")),
        (id: "world_damage_reduced", renderer: Sphere, material: "effect_damage", scale_multiplier: 0.6363636, lifetime: Millis(120), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: None),
        (id: "world_explosion", renderer: GroundRing, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(280), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: Some("world_explosion_reduced")),
        (id: "world_explosion_reduced", renderer: GroundRing, material: "effect_damage", scale_multiplier: 1.0, lifetime: Millis(120), concurrency_cap: 96, fallback_profile: "damage", reduced_profile: None),
        (id: "pickup_spawn", renderer: GroundRing, material: "pickup_glow", scale_multiplier: 1.0, lifetime: Millis(300), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: Some("pickup_ring_reduced")),
        (id: "pickup_collect", renderer: Sphere, material: "pickup_glow", scale_multiplier: 1.0, lifetime: Millis(300), concurrency_cap: 96, fallback_profile: "impact", reduced_profile: Some("pickup_sphere_reduced")),
