// Client-only gameplay camera rig tuning (BRL-0143; per-weapon and per-hit shake, BRL-0173;
// reach-aware look-ahead, BRL-vptw). Presentation only: none of these values
// feed aim, targeting, input, or simulation. Code-owned ceilings live in
// `packages/brawler-client/src/presentation_3d/camera_rig.rs`; framing (FOV, elevation, distance) stays in
// `camera.rs`.
(
    schema_version: 3,
    follow: (
        // Critically damped follow of the presented (predicted) local fighter pose.
        smooth_seconds: 0.11,
        // Reduced motion keeps the camera nearly rigid instead of trailing the fighter.
        reduced_motion_smooth_seconds: 0.03,
        // A larger jump (respawn, teleport) snaps instead of sweeping across the map.
        snap_distance_cells: 6.0,
    ),
    look_ahead: (
        // Lean toward the aim direction; disabled under reduced motion. Every aim leans at least
        // `distance_cells`; a weapon whose reach (plus `reach_margin_cells`) runs past the visible
        // ground in the aim direction leans further, up to `max_distance_cells`. The view is
        // shallower toward the bottom and top of the screen than to the sides, so vertical aim
        // leans more than horizontal aim for the same weapon.
        distance_cells: 1.5,
        max_distance_cells: 5.0,
        reach_margin_cells: 0.25,
        // The lean never brings the fighter closer than this to a screen edge.
        fighter_safe_margin_cells: 1.0,
        smooth_seconds: 0.32,
        // Mouse/placement aim at this distance from the fighter leans fully; closer aim leans
        // less. Direction-only stick aim always leans fully. Must stay well above
        // `max_distance_cells` so a mouse cursor cannot pull the view after itself.
        full_strength_aim_distance_cells: 8.0,
    ),
    shake: (
        max_offset_world: 6.0,
        frequency_hz: 16.0,
        decay_per_second: 1.8,
        exponent: 2.0,
        triggers: (
            // Local fire by the primary weapon's delivery family: heavy weapons shake more than
            // light, fast ones. Player-authored weapons share their family's value.
            local_fire: (
                straight: 0.12,
                sticky_straight: 0.16,
                lobbed: 0.22,
                melee_arc: 0.16,
                cone_spray: 0.08,
                splash: 0.14,
                // A spread pattern (Scatter Cannon) is one blast of several pellets.
                spread_scale: 1.75,
            ),
            local_ultimate: 0.14,
            // Damage taken scales with the hit's share of maximum health; a hit of at least
            // `full_strength_health_fraction` reaches `maximum`.
            local_damage: (
                minimum: 0.2,
                maximum: 0.6,
                full_strength_health_fraction: 0.3,
            ),
            local_defeat: 0.7,
            nearby_explosion: 0.6,
            nearby_defeat: 0.3,
            falloff_radius_cells: 9.0,
        ),
    ),
)
