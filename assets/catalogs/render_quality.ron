// Client-only presentation quality tiers (BRL-0161). Presentation only: nothing here feeds
// simulation, the gameplay content fingerprint, or the server feature graph. The player picks
// Auto/Low/Medium/High in Settings > Display; Auto resolves from detected GPU capability (no
// compute-capable GPU particles -> low, Android -> medium, otherwise high). Code-owned ceilings
// (MSAA at most 4 samples, bloom needs HDR, CPU particle caps, the 60 FPS target) live in
// `packages/brawler-client/src/presentation_3d/render_quality.rs`. Outlines, the toon material, and contact
// shadows stay on in every tier because they carry readability. Floor decals (BRL-0178) are
// decoration and are dropped on low.
(
    schema_version: 2,
    // The accepted desktop look: unchanged from before tiers existed.
    high: (
        msaa: Sample4,
        hdr: true,
        bloom: true,
        // Arena cast shadows (BRL-0180): one cascade covering the visible ground, so walls,
        // props, and fighters shadow the floor. Medium and low skip the shadow pass entirely.
        shadow_maps: true,
        foliage_sway: true,
        floor_decals: true,
        particles: Gpu,
    ),
    // Mid-range phones (the Pixel 8a target).
    medium: (
        msaa: Off,
        hdr: true,
        bloom: false,
        shadow_maps: false,
        foliage_sway: true,
        floor_decals: true,
        particles: Gpu,
    ),
    // Low-end phones and GPUs without compute-capable particles.
    low: (
        msaa: Off,
        hdr: false,
        bloom: false,
        shadow_maps: false,
        foliage_sway: false,
        floor_decals: false,
        particles: Cpu,
    ),
)
