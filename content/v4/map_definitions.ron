(
    schema_version: 4,
    policy: (
        max_geometry: 256,
        max_visual_instances: 1024,
        max_entities: 128,
        max_regions: 32,
        max_spawn_areas: 8,
        max_spawn_points: 32,
        max_mode_anchors: 32,
        permitted_collision_profiles: [CollisionProfileId(1)],
        permitted_presentation_profiles: [MapPresentationProfileId(1), MapPresentationProfileId(2), MapPresentationProfileId(3), MapPresentationProfileId(4), MapPresentationProfileId(5), MapPresentationProfileId(6)],
        permitted_region_profiles: [RegionProfileId(1)],
        permitted_entity_definitions: [EntityDefinitionId(1)],
        permitted_mode_definitions: [ModeDefinitionId(1), ModeDefinitionId(2), ModeDefinitionId(3)],
        permitted_anchor_definitions: [ModeAnchorDefinitionId(1), ModeAnchorDefinitionId(2)],
    ),
    presentation_themes: [
        (id: MapPresentationThemeId(1), key: "training-arena-mixed"),
        (id: MapPresentationThemeId(2), key: "ashen-court"),
    ],
    presentation_profiles: [
        (id: MapPresentationProfileId(1), key: "facility-floor"),
        (id: MapPresentationProfileId(2), key: "facility-wall"),
        (id: MapPresentationProfileId(3), key: "destruction-reservation"),
        (id: MapPresentationProfileId(4), key: "team-spawn"),
        (id: MapPresentationProfileId(5), key: "inert-decoration"),
        (id: MapPresentationProfileId(6), key: "hot-zone-objective"),
    ],
    collision_profiles: [(id: CollisionProfileId(1), key: "permanent-terrain")],
    region_profiles: [(id: RegionProfileId(1), key: "destructible-reservation")],
    entity_definitions: [(id: EntityDefinitionId(1), key: "inert-decoration")],
    mode_definitions: [
        (id: ModeDefinitionId(1), key: "sandbox-base"),
        (id: ModeDefinitionId(2), key: "wipeout"),
        (id: ModeDefinitionId(3), key: "hot-zone"),
    ],
    anchor_definitions: [
        (id: ModeAnchorDefinitionId(1), key: "practice-dummy-spawn"),
        (id: ModeAnchorDefinitionId(2), key: "hot-zone-objective"),
    ],
)
