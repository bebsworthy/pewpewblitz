<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (BRL-06pz): the PewPew Blitz lockup over the brand navy, plus a
     monochrome layer for themed icons. Layers come from asset_src/android/build_launcher_icons.swift;
     the legacy mipmap-*dpi/ic_launcher.png files stay for tools that read them. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
